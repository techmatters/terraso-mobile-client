+    // terraso-mobile-client patch: enable ProRAW at configure time when the
+    // active session format supports it. AVCapturePhotoOutput.isAppleProRAW-
+    // Supported returns false before the session has an active input+format
+    // (which is what happens in the init() above on modern iPhones), so the
+    // init-time enablement is effectively a no-op and no RAW pixel formats
+    // populate availableRawPhotoPixelFormatTypes at capture time. Re-set here,
+    // once the active format is known. On iPhone Pro devices the resulting
+    // capture is a ProRAW LinearRaw DNG (PhotometricInterpretation=34892);
+    // the decoder handles it via the LinearRaw branch. On older devices
+    // where plain Bayer is available, this path still works — bestRawPixelFormat
+    // prefers ProRAW when enabled, which is our intent for now.
+    if options.containerFormat == .dng
+      && output.isAppleProRAWSupported
+      && !output.isAppleProRAWEnabled {
+      output.isAppleProRAWEnabled = true
+      try? prepareDefaultPhotoSettings()
