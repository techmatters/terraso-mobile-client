@@ -207,6 +207,28 @@ enum ConstraintResolver {
           "The given `device` does not have any `formats` that support the attached Outputs!")
     }
 
+    // 4. terraso-mobile-client patch: if any output needs plain-Bayer
+    // RAW, hard-filter to formats whose max dimensions are ≤ 4032×3024.
+    // On iPhone Pro devices, higher-res formats (24/48 MP) expose only
+    // Apple ProRAW in availableRawPhotoPixelFormatTypes — plain Bayer is
+    // available only on the 12 MP binned photo format. Without this
+    // filter, preferHighestPhotoQuality picks the 48 MP HDR-required
+    // non-binned format and the RAW capture attempt throws "This
+    // PhotoOutput does not support raw capture" at the shutter.
+    let needsPlainBayerRaw = outputs.contains { $0.requiresPlainBayerRawFormat }
+    if needsPlainBayerRaw {
+      formats = formats.filter { format in
+        let dims = format.formatDescription.dimensions
+        return dims.width <= 4032 && dims.height <= 3024
+      }
+      guard !formats.isEmpty else {
+        throw RuntimeError.error(
+          withMessage:
+            "The given `device` does not have any `formats` at ≤ 4032×3024 for plain-Bayer RAW capture. On iPhone Pro devices, bind to a single-camera physical device (e.g. the built-in wide-angle) rather than a virtual multi-cam device."
+        )
+      }
+    }
+
     return formats
   }
 }
