diff --git a/node_modules/@gorhom/bottom-sheet/src/hooks/executeWithLock.ts b/node_modules/@gorhom/bottom-sheet/src/hooks/executeWithLock.ts
new file mode 100644
index 0000000..42c2026
--- /dev/null
+++ b/node_modules/@gorhom/bottom-sheet/src/hooks/executeWithLock.ts
@@ -0,0 +1,17 @@
+type Lock = {
+  value: boolean;
+};
+
+export function executeWithLock(lock: Lock, operation: () => void) {
+  'worklet';
+  if (lock.value) {
+    return;
+  }
+
+  lock.value = true;
+  try {
+    operation();
+  } finally {
+    lock.value = false;
+  }
+}
