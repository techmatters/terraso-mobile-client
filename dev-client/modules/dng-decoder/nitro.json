{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["dngdecoder"],
  "ios": {
    "iosModuleName": "DngDecoder"
  },
  "android": {
    "androidNamespace": ["dngdecoder"],
    "androidCxxLibName": "DngDecoder"
  },
  "autolinking": {
    "DngDecoder": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridDngDecoder"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridDngDecoder"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
