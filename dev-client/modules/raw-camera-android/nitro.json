{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["rawcameraandroid"],
  "ios": {
    "iosModuleName": "RawCameraAndroid"
  },
  "android": {
    "androidNamespace": ["rawcameraandroid"],
    "androidCxxLibName": "RawCameraAndroid"
  },
  "autolinking": {
    "RawCameraAndroid": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridRawCameraAndroid"
      }
    },
    "FrameAnalyzer": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridFrameAnalyzer"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
