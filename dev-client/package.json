{
  "name": "terraso-mobile-client",
  "version": "1.4.7",
  "private": true,
  "scripts": {
    "android": "npx dotenv -e ~/secrets/terraso-mobile-client/.env -- expo run:android",
    "ios": "npx dotenv -e ~/secrets/terraso-mobile-client/.env -- expo run:ios",
    "rebuild-all": "bash scripts/rebuild_all",
    "rebuild-all-ios": "bash scripts/rebuild_all ios",
    "rebuild-all-android": "bash scripts/rebuild_all android",
    "list-ios-devices": "bash scripts/list-ios-devices",
    "pick-ios-device": "bash scripts/pick-ios-device",
    "eslint": "eslint ./ --ext .js --ext .ts --ext .tsx --max-warnings 0 --ignore-path ../.gitignore",
    "lint": "npm run eslint && npm run prettier",
    "lint-js": "npm run lint",
    "prettier": "prettier --check .",
    "prettier-format": "prettier --write .",
    "format": "npm run eslint --fix && npm run prettier-format",
    "format-js": "npm run format",
    "start": "npx dotenv -e ~/secrets/terraso-mobile-client/.env -- expo start --dev-client",
    "test": "jest",
    "test:unit": "jest -c jest.unit.config.js",
    "test:integration": "jest -c jest.integration.config.js",
    "update-tests": "npm run test -- -u",
    "check-ts": "tsc --noEmit",
    "check-modules": "depcheck",
    "build:dng-cli": "./tools/dng-cli/build.sh",
    "build:dng-cli-cpp": "./tools/dng-cli-cpp/build.sh",
    "analyze-fixtures": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/analyze-fixtures.ts",
    "render-munsell-error": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/render-munsell-error.ts",
    "prebuild": "expo prebuild",
    "clean-watchman": "watchman watch-del-all && watchman shutdown-server",
    "i18n-check": "node scripts/i18n/check.mjs",
    "i18n-fill-missing": "node scripts/i18n/fill-missing.mjs",
    "i18n-delete-unused": "node scripts/i18n/delete-unused.mjs",
    "i18n-to-po": "node scripts/i18n/transform-to.mjs po",
    "i18n-to-json": "node scripts/i18n/transform-to.mjs json",
    "poeditor-download": "npx dotenv -e ~/secrets/terraso-mobile-client/.env -- node scripts/i18n/poeditor-download.mjs",
    "poeditor-upload": "npx dotenv -e ~/secrets/terraso-mobile-client/.env -- node scripts/i18n/poeditor-upload.mjs",
    "poeditor-merge": "npx dotenv -e ~/secrets/terraso-mobile-client/.env -- node scripts/i18n/poeditor-merge.mjs",
    "poeditor-create-test-project": "npx dotenv -e ~/secrets/terraso-mobile-client/.env -- node scripts/i18n/poeditor-create-test-project.mjs",
    "generate-munsell-test-data": "node scripts/generateMunsellTestData.js",
    "prepare": "cd .. && husky ./dev-client/.husky",
    "postinstall": "node scripts/fix-duplicate-react.js && npx patch-package"
  },
  "dependencies": {
    "@craftzdog/react-native-buffer": "^6.1.1",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.4.9",
    "@react-navigation/material-top-tabs": "^7.3.8",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.28",
    "@reduxjs/toolkit": "^2.9.0",
    "@rnmapbox/maps": "^10.3.5",
    "@sentry/core": "~10.37.0",
    "@sentry/react-native": "~7.11.0",
    "base-64": "^1.0.0",
    "crypto-js": "^4.2.0",
    "delta-e": "^0.0.8",
    "dng-decoder": "file:./modules/dng-decoder",
    "dotenv-cli": "^11.0.0",
    "expo": "~56.0.0",
    "expo-apple-authentication": "~56.0.4",
    "expo-application": "~56.0.3",
    "expo-asset": "~56.0.21",
    "expo-auth-session": "~56.0.16",
    "expo-build-properties": "~56.0.24",
    "expo-camera": "~56.0.8",
    "expo-checkbox": "~56.0.1",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.22",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.24",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-image-manipulator": "~56.0.23",
    "expo-image-picker": "~56.0.22",
    "expo-keep-awake": "~56.0.3",
    "expo-linking": "~56.0.16",
    "expo-localization": "~56.0.6",
    "expo-location": "~56.0.22",
    "expo-media-library": "~56.0.10",
    "expo-modules-core": "~56.0.22",
    "expo-screen-orientation": "~56.0.5",
    "expo-sensors": "~56.0.6",
    "expo-video": "~56.1.4",
    "expo-web-browser": "~56.0.6",
    "formik": "^2.4.6",
    "frame-analyzer": "file:./modules/frame-analyzer",
    "haversine": "^1.1.1",
    "i18next": "^25.6.0",
    "intl-pluralrules": "^2.0.1",
    "jpeg-js": "^0.4.4",
    "munsell": "^1.1.6",
    "native-base": "^3.4.28",
    "posthog-react-native": "^4.10.1",
    "posthog-react-native-session-replay": "^1.2.1",
    "promise": "^8.3.0",
    "quantize": "^1.0.2",
    "raw-camera-android": "file:./modules/raw-camera-android",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^15.7.4",
    "react-native": "0.85.3",
    "react-native-autocomplete-input": "^5.5.6",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-get-random-values": "^1.11.0",
    "react-native-gradle-plugin": "^0.72.1",
    "react-native-mmkv": "^3.3.3",
    "react-native-nitro-image": "^0.15.1",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-pager-view": "8.0.1",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-share": "^12.2.1",
    "react-native-svg": "15.15.4",
    "react-native-tab-view": "^4.1.3",
    "react-native-vision-camera": "^5.1.1",
    "react-native-vision-camera-worklets": "^5.1.1",
    "react-native-worklets": "0.8.3",
    "react-redux": "^9.2.0",
    "reduce-reducers": "^1.0.4",
    "setimmediate": "^1.0.5",
    "terraso-client-shared": "github:techmatters/terraso-client-shared#2026-07-16.0",
    "use-debounce": "^10.0.6",
    "uuid": "^11.1.0",
    "yup": "^1.7.1"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@types/react": "~19.2.10",
    "@reduxjs/toolkit": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    },
    "terraso-client-shared": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@types/react": "~19.2.10",
      "@reduxjs/toolkit": {
        "react": "19.2.3",
        "react-dom": "19.2.3"
      }
    }
  },
  "resolutions": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/runtime": "^7.28.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@react-native-community/cli-doctor": "^16.0.3",
    "@react-native/babel-preset": "^0.81.6",
    "@react-native/eslint-config": "^0.76.6",
    "@react-native/jest-preset": "^0.85.3",
    "@react-native/typescript-config": "^0.76.6",
    "@testing-library/react-native": "^13.3.3",
    "@types/base-64": "^1.0.2",
    "@types/crypto-js": "^4.2.2",
    "@types/delta-e": "^0.0.2",
    "@types/haversine": "^1.1.8",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.20",
    "@types/quantize": "^1.0.2",
    "@types/react": "~19.2.10",
    "@types/uuid": "^10.0.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-root-import": "^6.6.0",
    "depcheck": "^1.4.7",
    "diff": "^8.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.3",
    "flat": "^6.0.1",
    "gettext-parser": "^9.0.2",
    "husky": "^9.1.7",
    "i18next-conv": "^15.1.2",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "lint-staged": "^15.5.2",
    "lodash": "^4.17.21",
    "node-pty": "^1.1.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.6.2",
    "react-devtools": "^4.28.5",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "19.2.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3"
  },
  "jest": {
    "projects": [
      "<rootDir>/jest.unit.config.js",
      "<rootDir>/jest.integration.config.js"
    ]
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-application"
      ]
    }
  },
  "ignore": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "src/tests",
    "jest"
  ],
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "sh -c 'npm run eslint && npm run check-ts'"
    ],
    "**/*.{json,ts,tsx,html}": [
      "sh -c 'npm run prettier'"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
